      "title": "Waste Avoided (Recovery Savings)",
      "type": "stat",
      "targets": [
        {
          "rawSql": "SELECT COALESCE(SUM(m.cost_usd), 0) AS waste_avoided FROM llm_metrics m INNER JOIN checkpoints c ON c.namespace = m.namespace AND c.pod_name = m.pod_name AND c.step_index = m.step_index WHERE c.context::text LIKE '%recovery%';",
