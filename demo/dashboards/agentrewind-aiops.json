      "title": "Success Rate",
      "type": "gauge",
      "targets": [
        {
          "rawSql": "SELECT ROUND(100.0 * COUNT(DISTINCT CASE WHEN max_step >= 4 THEN trace_id END) / NULLIF(COUNT(DISTINCT trace_id), 0), 1) AS \"success_rate\" FROM (SELECT trace_id, MAX(step_index) AS max_step FROM checkpoints GROUP BY trace_id) sub;",
          "refId": "A",
          "format": "table"
        }
